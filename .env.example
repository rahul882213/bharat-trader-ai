# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database configuration (SQLite default; set DATABASE_URL for PostgreSQL)
DATABASE_URL="sqlite:///./bharat_trader.db"

# Trading Execution Mode (paper | live) - ALWAYS defaults to paper
TRADING_MODE="paper"

# Zerodha Kite Connect API Credentials (Never hardcode in source code)
KITE_API_KEY=""
KITE_API_SECRET=""
KITE_ACCESS_TOKEN=""

# Upstox API v2 Credentials
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_ACCESS_TOKEN=""

# Angel One SmartAPI Credentials
ANGEL_API_KEY=""
ANGEL_CLIENT_ID=""
ANGEL_MPIN=""
ANGEL_TOTP_SECRET=""

# DhanHQ API Credentials
DHAN_CLIENT_ID=""
DHAN_ACCESS_TOKEN=""

# Optional Telegram Alert Notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
