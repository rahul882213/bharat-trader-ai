# ==============================================================================
# Bharat Trader AI — Environment Configuration Template
# Never commit real secrets (.env is gitignored).
# ==============================================================================

# --- Frontend (Vite Build / GitHub Pages) ---
# Set to your deployed Render HTTPS backend URL before running `npm run build`
# Example format: https://<your-service>.onrender.com
VITE_API_BASE_URL=""

# --- Backend API & Security ---
# Comma-separated allowed CORS origins for the FastAPI backend
ALLOWED_ORIGINS="https://rahul882213.github.io,http://localhost:3000"
RATE_LIMIT_PER_MIN="120"
HEAVY_RATE_LIMIT_PER_MIN="30"

# --- Server-Side Gemini AI Synthesis ---
# Configure only on the backend (Render Environment Variables). Never expose to frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# --- Database (PostgreSQL for Supabase/Render, or SQLite for standalone tests) ---
# Supabase PostgreSQL format:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="sqlite:///./bharat_trader.db"

# --- Execution Mode (ALWAYS defaults to paper) ---
TRADING_MODE="paper"

# --- Optional Broker API Credentials (Backend Only) ---
KITE_API_KEY=""
KITE_API_SECRET=""
KITE_ACCESS_TOKEN=""

UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_ACCESS_TOKEN=""

ANGEL_API_KEY=""
ANGEL_CLIENT_ID=""
ANGEL_MPIN=""
ANGEL_TOTP_SECRET=""

DHAN_CLIENT_ID=""
DHAN_ACCESS_TOKEN=""

# --- Optional Telegram Alerts ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
